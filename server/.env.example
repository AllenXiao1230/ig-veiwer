# Bind to localhost by default. Set this to a Tailscale IP for tailnet-only access.
IG_TRENDS_BIND_HOST=127.0.0.1
IG_TRENDS_PORT=8085

# Required for POST ingestion endpoints. Generate with: openssl rand -hex 32
IG_TRENDS_API_TOKEN=replace-with-a-long-random-token

# Time zone and daily scan time for /incoming. Use HH:MM in 24-hour format.
IG_TRENDS_TIMEZONE=Asia/Taipei
IG_TRENDS_DAILY_INGEST_TIME=03:30

# Retain archived source JSON for this many days (0 disables automatic deletion).
IG_TRENDS_ARCHIVE_RETENTION_DAYS=90

# Optional Google Drive pull.  This sidecar is inactive until started with
# `docker compose --profile google-drive up -d` after rclone OAuth setup.
IG_TRENDS_GDRIVE_REMOTE=igdrive
IG_TRENDS_GDRIVE_PATH=IG Exports/current
IG_TRENDS_GDRIVE_SYNC_INTERVAL_SECONDS=900
